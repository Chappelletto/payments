PaymentsApi - дописать методы

-------------------------------------------------------------
rescue
error = begin # объявляем блок, чтобы потом перехватить в нём ошибку
  PaymentsApi.new.update_payment(id: 2, amount:0, date:"2024-09-09") # <-- здесь упадёт ошибка
rescue => e # перехватываем ошибку, без явного указания класса ошибки. В этом случае будет перехватываться ЛЮБАЯ ошибка (StandardError)
  e # блок возвращает объект ошибки, который сложится в переменную error (она выше)
end
